# URL de l'API REST CESIZen utilisée par l'application mobile.
# Préfixe EXPO_PUBLIC_ requis pour être exposée au bundle Expo.
# En production, pointer vers l'API HTTPS (ex. https://api.cesizen.fr/api/v1).
# En dev, laisser vide : l'app retombe sur localhost / 10.0.2.2 selon la plateforme.
EXPO_PUBLIC_API_URL=
